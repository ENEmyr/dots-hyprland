#!/usr/bin/python3
"""OpenAI-compatible HTTP bridge for local agent CLIs.

The illogical-impulse sidebar can only talk to HTTP endpoints in OpenAI,
Gemini or Mistral format. Claude Code, Codex and Antigravity are CLIs that
authenticate with their own subscriptions, so this server translates one
`POST /v1/chat/completions` request into a single headless CLI run and streams
the reply back as Server-Sent Events.

Chat only: every backend is started with its tools disabled or read-only, and
with a scratch working directory, so a sidebar message cannot touch real files.
"""

import json
import os
import shlex
import shutil
import subprocess
import sys
import threading
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST = os.environ.get("II_AI_BRIDGE_HOST", "127.0.0.1")
PORT = int(os.environ.get("II_AI_BRIDGE_PORT", "8765"))
HOME = os.path.expanduser("~")
WORKDIR = os.path.join(HOME, ".cache", "ii-ai-bridge")
CONFIG_PATH = os.environ.get(
    "II_AI_BRIDGE_CONFIG", os.path.join(HOME, ".config", "ii-ai-bridge", "backends.json")
)
TIMEOUT = int(os.environ.get("II_AI_BRIDGE_TIMEOUT", "300"))
ARGV_LIMIT = 100_000  # MAX_ARG_STRLEN is 128 KiB per argument

# Used when no backends.json exists. Personal setups (extra accounts, remote
# hosts, other model ids) belong in that file, not here.
DEFAULT_BACKENDS = {
    "cc-sonnet": {"kind": "claude", "model": "sonnet", "config_dir": "~/.claude"},
    "cc-opus": {"kind": "claude", "model": "opus", "config_dir": "~/.claude"},
    "codex": {"kind": "codex", "model": None},
    "agy-gemini-flash": {"kind": "agy", "model": "gemini-3.8-flash-medium"},
    "agy-claude-sonnet": {"kind": "agy", "model": "claude-sonnet-4-6"},
}

DEFAULT_BINARIES = {"claude": "claude", "codex": "codex", "agy": "agy", "ssh": "/usr/bin/ssh"}


def resolve_binary(name):
    """Prefer an explicit path, then PATH, then ~/.local/bin."""
    if os.path.sep in name:
        return os.path.expanduser(name)
    found = shutil.which(name)
    if found:
        return found
    return os.path.join(HOME, ".local", "bin", name)


def load_config():
    """Read backends.json, falling back to the built-in defaults."""
    config = {}
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH) as handle:
            config = json.load(handle)

    backends = config.get("backends") or DEFAULT_BACKENDS
    for backend in backends.values():
        if backend.get("config_dir"):
            backend["config_dir"] = os.path.expanduser(backend["config_dir"])

    binaries = dict(DEFAULT_BINARIES)
    binaries.update(config.get("binaries") or {})
    binaries = {key: resolve_binary(value) for key, value in binaries.items()}
    return backends, binaries


BACKENDS, BINARIES = load_config()


def log(*args):
    print(time.strftime("%H:%M:%S"), *args, file=sys.stderr, flush=True)


def flatten(messages):
    """Return (system_prompt, prompt) from an OpenAI messages array."""
    system_parts = []
    turns = []
    for message in messages:
        role = message.get("role", "user")
        content = message.get("content") or ""
        if isinstance(content, list):  # OpenAI content-part arrays
            content = "".join(part.get("text", "") for part in content if isinstance(part, dict))
        if not content.strip():
            continue
        if role == "system":
            system_parts.append(content)
        else:
            turns.append((role, content))

    if not turns:
        return "\n\n".join(system_parts), ""
    if len(turns) == 1:
        return "\n\n".join(system_parts), turns[0][1]

    history = "\n\n".join(
        ("User: " if role == "user" else "Assistant: ") + content for role, content in turns[:-1]
    )
    return (
        "\n\n".join(system_parts),
        f"Conversation so far:\n\n{history}\n\nReply to this final message from the user:\n\n{turns[-1][1]}",
    )


def build_command(backend, system_prompt, prompt):
    kind = backend["kind"]
    env = dict(os.environ)
    env.pop("ANTHROPIC_API_KEY", None)

    if kind == "claude":
        # The prompt arrives on stdin, so a long chat cannot hit MAX_ARG_STRLEN
        # and the conversation never shows up in /proc/<pid>/cmdline.
        env["CLAUDE_CONFIG_DIR"] = backend["config_dir"]
        command = [
            BINARIES["claude"], "-p",
            "--model", backend["model"],
            "--output-format", "stream-json",
            "--include-partial-messages",
            "--verbose",
            "--tools", "",
            "--setting-sources", "local",
            "--strict-mcp-config",
        ]
        if system_prompt:
            command += ["--system-prompt", system_prompt]
        return command, env, prompt

    if kind == "ssh_claude":
        # ssh joins the remote argv with spaces and the remote shell re-parses
        # it, so every remote argument is quoted here. The prompt still travels
        # on stdin, which ssh forwards.
        remote = [
            "claude", "-p",
            "--model", backend["model"],
            "--output-format", "stream-json",
            "--include-partial-messages",
            "--verbose",
            "--tools", "",
            "--setting-sources", "local",
            "--strict-mcp-config",
        ]
        if system_prompt:
            remote += ["--system-prompt", system_prompt]
        command = [
            BINARIES["ssh"], "-o", "BatchMode=yes", "-o", "ServerAliveInterval=15",
            "-o", "ServerAliveCountMax=3", backend["host"], "--",
            " ".join(shlex.quote(arg) for arg in remote),
        ]
        return command, env, prompt

    full = f"{system_prompt}\n\n{prompt}" if system_prompt else prompt

    if kind == "codex":
        return [BINARIES["codex"], "exec", "--json", "--sandbox", "read-only", "--skip-git-repo-check", "-"], env, full

    # agy ignores stdin as a prompt source, so this one leg keeps it in argv.
    command = [BINARIES["agy"], "--output-format", "stream-json", "--sandbox"]
    if backend["model"]:
        command += ["--model", backend["model"]]
    return command + ["--print", full], env, ""


def extract_text(kind, line):
    """Yield text fragments from one line of a CLI's JSON stream."""
    line = line.strip()
    if not line.startswith("{"):  # mise shims print a banner on stdout
        return
    try:
        data = json.loads(line)
    except json.JSONDecodeError:
        return

    if kind in ("claude", "ssh_claude"):
        if data.get("type") == "stream_event":
            event = data.get("event", {})
            if event.get("type") == "content_block_delta":
                delta = event.get("delta", {})
                if delta.get("type") == "text_delta":
                    yield delta.get("text", "")
        elif data.get("type") == "result" and data.get("is_error"):
            yield f"\n\n**Error**: {data.get('result', 'claude failed')}"
    elif kind == "codex":
        if data.get("type") == "item.completed":
            item = data.get("item", {})
            if item.get("type") == "agent_message":
                yield item.get("text", "")
        elif data.get("type") == "error":
            yield f"\n\n**Error**: {data.get('message', 'codex failed')}"
    else:
        if data.get("event") == "step_update":
            step = data.get("step_update", {})
            if step.get("step_type") == "agent_response":
                yield step.get("text_delta", "")
        elif data.get("event") == "result" and data.get("result", {}).get("status") != "SUCCESS":
            yield f"\n\n**Error**: {data.get('result', {}).get('status', 'agy failed')}"


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):  # quieter than the stdlib default
        pass

    def _json(self, code, payload):
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.rstrip("/") in ("/v1/models", "/models"):
            self._json(200, {"object": "list", "data": [
                {"id": name, "object": "model", "owned_by": backend["kind"]}
                for name, backend in BACKENDS.items()
            ]})
        else:
            self._json(404, {"error": {"message": "not found"}})

    def do_POST(self):
        if self.path.rstrip("/") not in ("/v1/chat/completions", "/chat/completions"):
            self._json(404, {"error": {"message": "not found"}})
            return

        length = int(self.headers.get("Content-Length") or 0)
        try:
            request = json.loads(self.rfile.read(length) or b"{}")
        except json.JSONDecodeError as exc:
            self._json(400, {"error": {"message": f"bad JSON: {exc}"}})
            return

        model = request.get("model", "")
        backend = BACKENDS.get(model)
        if backend is None:
            self._json(404, {"error": {"message": f"unknown model '{model}'"}})
            return

        system_prompt, prompt = flatten(request.get("messages", []))
        if not prompt:
            self._json(400, {"error": {"message": "no user message"}})
            return

        command, env, stdin_text = build_command(backend, system_prompt, prompt)
        if backend["kind"] == "agy" and len(command[-1].encode()) > ARGV_LIMIT:
            self._json(413, {"error": {"message":
                "conversation too long for the Antigravity CLI (prompt goes in argv); "
                "start a new chat or switch to a Claude or Codex model"}})
            return
        os.makedirs(WORKDIR, exist_ok=True)

        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "close")
        self.end_headers()

        completion_id = "chatcmpl-" + uuid.uuid4().hex[:24]
        started = time.time()
        log(f"start {model} ({backend['kind']})")

        try:
            process = subprocess.Popen(
                command, cwd=WORKDIR, env=env, stdin=subprocess.PIPE,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1,
            )
        except OSError as exc:
            self._chunk(completion_id, model, f"**Error**: cannot start {command[0]}: {exc}")
            self._write(f"data: {json.dumps({'id': completion_id, 'object': 'chat.completion.chunk', 'model': model, 'choices': [{'index': 0, 'delta': {}, 'finish_reason': 'stop'}]})}\n\n")
            self._write("data: [DONE]\n\n")
            return

        # The prompt goes in on stdin: a long chat blows past MAX_ARG_STRLEN as
        # an argv entry, and argv is world readable through /proc.
        def feed():
            try:
                process.stdin.write(stdin_text)
                process.stdin.close()
            except (BrokenPipeError, ValueError):
                pass

        threading.Thread(target=feed, daemon=True).start()

        # The read loop only notices a timeout when a line arrives, so a child
        # that blocks silently needs its own watchdog.
        watchdog = threading.Timer(TIMEOUT, process.kill)
        watchdog.daemon = True
        watchdog.start()

        first_token = None
        sent_any = False
        try:
            for line in process.stdout:
                if time.time() - started > TIMEOUT:
                    process.kill()
                    self._chunk(completion_id, model, "\n\n**Error**: bridge timeout")
                    break
                for text in extract_text(backend["kind"], line):
                    if not text:
                        continue
                    if first_token is None:
                        first_token = time.time() - started
                    sent_any = True
                    self._chunk(completion_id, model, text)
            process.wait(timeout=10)
            if not sent_any:
                stderr = (process.stderr.read() or "").strip().splitlines()
                tail = stderr[-1] if stderr else f"{command[0]} exited with {process.returncode}"
                self._chunk(completion_id, model, f"**Error**: {tail}")
            self._write(f"data: {json.dumps({'id': completion_id, 'object': 'chat.completion.chunk', 'model': model, 'choices': [{'index': 0, 'delta': {}, 'finish_reason': 'stop'}]})}\n\n")
            self._write("data: [DONE]\n\n")
        except (BrokenPipeError, ConnectionResetError):
            log(f"client gone, killing {model}")
            process.kill()
        finally:
            watchdog.cancel()
            if process.poll() is None:
                process.kill()
            log(f"done {model} first_token={first_token} total={time.time() - started:.1f}s")

    def _chunk(self, completion_id, model, text):
        payload = {
            "id": completion_id,
            "object": "chat.completion.chunk",
            "model": model,
            "choices": [{"index": 0, "delta": {"content": text}, "finish_reason": None}],
        }
        self._write(f"data: {json.dumps(payload)}\n\n")

    def _write(self, text):
        self.wfile.write(text.encode())
        self.wfile.flush()


def main():
    os.makedirs(WORKDIR, exist_ok=True)
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    log(f"ii-ai-bridge listening on http://{HOST}:{PORT} models={','.join(BACKENDS)}")
    server.serve_forever()


if __name__ == "__main__":
    main()
